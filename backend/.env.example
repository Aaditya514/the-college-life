# =============================================================================
# The College Life We Didn't Have — Environment Configuration Template
# Copy this file to '.env' and fill in your real credentials. NEVER commit '.env'.
# =============================================================================

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/collegelife_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here
SPRING_PROFILES_ACTIVE=prod

# JWT Secret Key (HMAC-SHA256, minimum 256 bits / 32 characters)
APP_JWT_SECRET=your_minimum_256_bit_secure_jwt_secret_key_here
APP_JWT_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://192.168.0.106:4200

# Email Delivery (Brevo SMTP & REST API)
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_brevo_smtp_username_here
SPRING_MAIL_PASSWORD=your_brevo_smtp_password_here
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email_here

# Content Moderation & AI Safety (Google Gemini)
MODERATION_MODE=HYBRID
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
